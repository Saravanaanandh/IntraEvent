GEMINI_API_KEY="MY_GEMINI_API_KEY"
PORT=3000
# MongoDB Atlas — every user login + every conversation turn is persisted here
# so an interrupt never loses progress (sessions resume on re-login).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
# Default Ollama Cloud model used with each participant's own API key
OLLAMA_MODEL="gpt-oss:20b"
